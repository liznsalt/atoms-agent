DATABASE_URL=sqlite:///./app.db

# LLM 协议：openai（OpenAI 兼容 /v1）或 anthropic（Anthropic 兼容）
# 智谱 GLM Coding Plan 订阅走 Anthropic 端点；按量计费资源走 OpenAI 兼容端点
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_API_KEY=
LLM_MODEL=glm-4.7

# OpenAI 兼容方式（按量计费资源）示例：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
